{
  "builds": [
    {
      "src": "webhook_receiver/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "dashboard/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/_next/(.*)",
      "dest": "dashboard/.next/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "webhook_receiver/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "dashboard/.next/server/pages/index.html",
      "check": true
    }
  ]
}