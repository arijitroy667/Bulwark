# ============================================================
# Bulwark — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control.
# ============================================================

# ─── GitLab Configuration ────────────────────────────────────
# The base URL of your GitLab instance (defaults to https://gitlab.com)
GITLAB_URL=https://gitlab.com
# GitLab Personal Access Token (PAT) with read_api and read_repository scopes
GITLAB_PAT=glpat-xxxxxxxxxxxxxxxxxxxx
# Secret token used to validate the signature of incoming GitLab webhooks
GITLAB_WEBHOOK_TOKEN=your-webhook-secret-token-here

# ─── Dynatrace Configuration ─────────────────────────────────
# Your Dynatrace environment ID (e.g., abc12345 in abc12345.live.dynatrace.com)
DYNATRACE_ENV_ID=abc12345
# Dynatrace API token with read permissions (v2 API: metrics, entities, etc.)
DYNATRACE_API_TOKEN=dt0c01.xxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Arize LLM Evaluation Configuration ─────────────────────
# API Key for Arize AI platform (used for LLM evaluation monitoring)
ARIZE_API_KEY=your-arize-api-key
# Arize Space ID where evaluation data and logs will be posted
ARIZE_SPACE_ID=your-arize-space-id-here

# ─── MongoDB Configuration ───────────────────────────────────
# MongoDB connection URI
# Local URI: mongodb://localhost:27017
# Production URI: mongodb+srv://username:password@cluster.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=bulwark

# ─── Google Cloud Platform ───────────────────────────────────
# GCP Project ID where resources are deployed
GCP_PROJECT_ID=bulwark-project
# GCP Region where Cloud Run and Artifact Registry are hosted
GCP_REGION=us-central1
# Artifact Registry repository name inside GCP where built images are stored
GCP_ARTIFACT_REGISTRY=bulwark-images
# Google Cloud Storage (GCS) bucket used for staging GitLab branch archives for Cloud Build
GCP_SOURCE_ARCHIVE_BUCKET=bulwark-build-sources

# ─── Gemini API Configuration ────────────────────────────────
# API Key for Google Gemini (used for LLM reasoning and explanation of verdicts)
GEMINI_API_KEY=your-gemini-api-key
# Gemini model used for text generation / verdict analysis
GEMINI_MODEL=gemini-2.0-flash

# ─── Bulwark Runtime Settings ────────────────────────────────
# Runtime mode: development | production (determines mock execution/logs bypass)
BULWARK_MODE=development
# Hard ceiling timeout in seconds for the entire orchestrator pipeline execution
SIMULATION_TIMEOUT_SECONDS=900
# Concurrency level for replaying traffic against the ephemeral container
REPLAY_CONCURRENCY=10
# Maximum number of production request samples to replay
REPLAY_REQUEST_LIMIT=200

# ─── Tiered Scoring & Verdict Thresholds ────────────────────
# Score thresholds used by the Verdict Writer / Orchestrator
CONFIDENCE_THRESHOLD_APPROVED=80
CONFIDENCE_THRESHOLD_WARNING=50

# ─── v3 Scoring & Noise Floors (PRD §8) ──────────────────────
# p95 latency noise floor in milliseconds (signals within this are ignored)
P95_NOISE_FLOOR_MS=35.0
# Error rate noise floor as a percentage
ERROR_RATE_NOISE_FLOOR_PERCENT=1.0
# LLM evaluation confidence noise band
LLM_EVAL_NOISE_BAND=0.10

# ─── Phase 2: MCP Integration Server URLs (SSE endpoints) ────
# Cloud Run SSE service endpoints for Model Context Protocol servers
# Format: https://<service>-<hash>-<region>.a.run.app/sse
GITLAB_MCP_URL=https://gitlab-mcp-xxxxxxxx-xxxx.a.run.app/sse
DYNATRACE_MCP_URL=https://dynatrace-mcp-xxxxxxxx-xxxx.a.run.app/sse
ARIZE_MCP_URL=https://arize-mcp-xxxxxxxx-xxxx.a.run.app/sse

# Optional shared bearer token for authenticating calls to the MCP servers
MCP_AUTH_TOKEN=your-mcp-bearer-token-here

# ─── Demo Application Settings (Optional / Dev-only) ─────────
# These settings control the local demo app behavior
DEMO_VERSION=fixed
WIREMOCK_BASE_URL=http://localhost:8082
SIMULATED_DB_LATENCY_MS=12
